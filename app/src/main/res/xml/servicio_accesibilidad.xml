<?xml version="1.0" encoding="utf-8"?>
<!--
  Dos usos, ambos acotados:
  1. Home: escucha cambios de ventana del launcher de Amazon para abrir Lyra.
  2. Búsqueda guiada: tras pulsar «Buscar en X» en el launcher, escribe el título en el buscador de IPTV o Crunchyroll durante ~20 s.
  Solo ve las ventanas de los paquetes listados; el contenido solo se lee mientras hay una búsqueda armada.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/descripcion_accesibilidad"
    android:notificationTimeout="100"
    android:packageNames="com.amazon.tv.launcher,com.example.iptv,com.crunchyroll.crunchyroid,com.hbo.hbonow,com.amazon.tv.ime" />
